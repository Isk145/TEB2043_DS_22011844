library(plotrix)

titanic_cleaned <- read.csv("C:/Users/User/Downloads/titanic_cleaned.csv")

View(titanic_cleaned)

boxplot(mpg ~ cyl, data = mtcars,
        xlab = "Male",
        ylab = "Female",
        main = "Gender Survival Rate",
        notch = TRUE,
        varwidth = TRUE, 
        col = c("green","yellow","purple"),
        names = c("High","Medium","Low")
