library(plotrix)
data(mtcars)
View(mtcars)

hist(mtcars$mpg,
     main = "Distribution of Car Fuel Efficiency (MPG)",
     xlab = "Miles Per Gallon",
     col = "lightblue",
     border = "black")

plot(mtcars$wt, mtcars$mpg,
     main = "Car Weight vs Fuel Efficiency",
     xlab = "Weight",
     ylab = "Miles Per Gallon",
     col = "blue",
     pch = 19)

